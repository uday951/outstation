# Copy to .env for local work, and set the same values on your host. Never commit .env.

# The address canonicals, sitemap, schema and payment returns use. Set at BUILD time.
# Without it: Render uses its onrender.com address (noindex), elsewhere bestambulance.in.
# On Render, set this to https://bestambulance.in at cutover, not before.
# SITE_URL=https://bestambulance.in

# ---- Enquiry delivery ----
# Configure at least one channel. Until then the forms honestly tell visitors the request
# was not sent and point them to phone and WhatsApp. They never show a false success.

# Option 1: email via Resend (https://resend.com). LEAD_FROM_EMAIL must be on a domain verified with Resend.
RESEND_API_KEY=
LEAD_TO_EMAIL=care@bestambulance.in
LEAD_FROM_EMAIL=

# Option 2: any webhook that accepts JSON POSTs (Google Apps Script to a Sheet, Make, Zapier, a CRM).
# Must answer with a 2xx status for the request to count as delivered.
LEAD_WEBHOOK_URL=

# ---- Online advance payments (Cashfree) ----
# Keys come from the Cashfree dashboard: Payment Gateway > Developers > API Keys.
# Until both are set, the pay page says online payment is unavailable and charges nothing.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# Stays in test mode unless this is exactly "production". Use test keys with sandbox, live keys with production.
CASHFREE_ENV=sandbox
