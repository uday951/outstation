---
// Line icons from Lucide (ISC licence). Only those listed here reach the page.
import accessibility from 'lucide-static/icons/accessibility.svg?raw';
import activity from 'lucide-static/icons/activity.svg?raw';
import ambulance from 'lucide-static/icons/ambulance.svg?raw';
import arrowUpRight from 'lucide-static/icons/arrow-up-right.svg?raw';
import baby from 'lucide-static/icons/baby.svg?raw';
import bandage from 'lucide-static/icons/bandage.svg?raw';
import building from 'lucide-static/icons/building-2.svg?raw';
import check from 'lucide-static/icons/check.svg?raw';
import chevronDown from 'lucide-static/icons/chevron-down.svg?raw';
import clipboard from 'lucide-static/icons/clipboard-list.svg?raw';
import clock from 'lucide-static/icons/clock.svg?raw';
import cross from 'lucide-static/icons/cross.svg?raw';
import fan from 'lucide-static/icons/fan.svg?raw';
import fileText from 'lucide-static/icons/file-text.svg?raw';
import heartPulse from 'lucide-static/icons/heart-pulse.svg?raw';
import hospital from 'lucide-static/icons/hospital.svg?raw';
import mapPin from 'lucide-static/icons/map-pin.svg?raw';
import phone from 'lucide-static/icons/phone.svg?raw';
import phoneIncoming from 'lucide-static/icons/phone-incoming.svg?raw';
import plane from 'lucide-static/icons/plane.svg?raw';
import planeTakeoff from 'lucide-static/icons/plane-takeoff.svg?raw';
import route from 'lucide-static/icons/route.svg?raw';
import shieldCheck from 'lucide-static/icons/shield-check.svg?raw';
import shieldPlus from 'lucide-static/icons/shield-plus.svg?raw';
import siren from 'lucide-static/icons/siren.svg?raw';
import snowflake from 'lucide-static/icons/snowflake.svg?raw';
import stethoscope from 'lucide-static/icons/stethoscope.svg?raw';
import syringe from 'lucide-static/icons/syringe.svg?raw';
import train from 'lucide-static/icons/train-front.svg?raw';
import userCheck from 'lucide-static/icons/user-check.svg?raw';
import users from 'lucide-static/icons/users.svg?raw';
import wind from 'lucide-static/icons/wind.svg?raw';
import x from 'lucide-static/icons/x.svg?raw';

const whatsapp = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 14.4c-.3-.2-1.8-.9-2-1-.3-.1-.5-.1-.7.2l-.9 1.2c-.2.2-.3.2-.6.1-.3-.2-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.5.3-.5c.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.2.2 2.1 3.2 5.1 4.5 2.5 1.1 3 .9 3.5.8.5-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.1-.3-.2-.6-.3ZM12 2a10 10 0 0 0-8.5 15.2L2 22l4.9-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-2.9.8.8-2.8-.2-.3A8.2 8.2 0 1 1 12 20.2Z"/></svg>';

const icons = {
  accessibility, activity, ambulance, arrowUpRight, baby, bandage, building, check, chevronDown, clipboard, clock, cross, fan, fileText,
  heartPulse, hospital, mapPin, phone, phoneIncoming, plane, planeTakeoff, route, shieldCheck, shieldPlus, siren, snowflake, stethoscope,
  syringe, train, userCheck, users, whatsapp, wind, x,
  // names used before this set was added
  form: clipboard,
  callback: phoneIncoming,
};
export type IconName = keyof typeof icons;
interface Props { name: IconName; }
const svg = icons[Astro.props.name as IconName]
  .replace(/<!--[\s\S]*?-->/, '')
  .replace(/\s(class|width|height)="[^"]*"/g, '')
  .replace('<svg', '<svg aria-hidden="true" focusable="false"')
  .replace(/>\s+</g, '><')
  .trim();
---
<Fragment set:html={svg} />
