---
import Base from '../layouts/Base.astro';
import ContactActions from '../components/ContactActions.astro';
---
<Base title="Request Not Sent | Best Ambulance Service" description="Your request could not be sent. Please call or WhatsApp us." noindex>
  <section class="page-hero">
    <div class="wrap">
      <h1 class="h1-page">Your request was not sent.</h1>
      <p class="lead">Something was missing from the form, or our system could not deliver it. Please call or WhatsApp us, and we can take the details directly.</p>
      <ContactActions />
    </div>
  </section>
</Base>
