---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import FinalCta from '../../components/FinalCta.astro';
import Icon from '../../components/Icon.astro';
import { guides } from '../../data/guides';
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Guides', href: '/blog' }];
---
<Base title="Patient Transfer Guides for Families | Outstation Ambulance" description="Practical guides for families arranging a long-distance ambulance: booking steps, choosing a vehicle, oxygen planning, and hospital-to-hospital transfers." crumbs={crumbs}>
  <Crumbs items={crumbs} />
  <section class="page-hero">
    <div class="wrap">
      <h1 class="h1-page">Guides for families arranging a transfer</h1>
      <p class="lead">Plain answers for an unfamiliar situation. General information only: the treating doctor decides what is safe for your patient.</p>
    </div>
  </section>
  <section class="section--tight">
    <div class="wrap">
      <div class="cards">
        {guides.map((g, i) => (
          <a class="card reveal" style={`--i:${i % 3}`} href={`/blog/${g.slug}`}>
            <span class="tile"><Icon name="fileText" /></span>
            <h2 style="font-size:var(--t-h3);letter-spacing:-0.016em;font-weight:700;line-height:1.25">{g.title}</h2>
            <p>{g.summary}</p>
            <span class="go">Read guide <Icon name="arrowUpRight" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <FinalCta />
</Base>
