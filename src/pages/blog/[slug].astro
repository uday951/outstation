---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import FinalCta from '../../components/FinalCta.astro';
import { article } from '../../lib/schema';
import { guides, type Guide } from '../../data/guides';
import { business, telHref } from '../../data/business';

export function getStaticPaths() {
  return guides.map((g) => ({ params: { slug: g.slug }, props: { g } }));
}
const { g } = Astro.props as { g: Guide };
const site = (Astro.site?.href ?? '').replace(/\/$/, '');
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Guides', href: '/blog' }, { name: g.title, href: `/blog/${g.slug}` }];
const url = `${site}/blog/${g.slug}`;
const others = guides.filter((x) => x.slug !== g.slug).slice(0, 3);
const fmt = new Date(g.published).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={g.metaTitle} description={g.description} crumbs={crumbs} pageType="WebPage" schema={[article(site, url, g.title, g.description, g.published, g.published)]}>
  <Crumbs items={crumbs} />
  <article>
    <header class="page-hero">
      <div class="wrap">
        <h1 class="h1-page" style="max-width:20ch">{g.title}</h1>
        <p class="small muted" style="margin-top:var(--s-4)">By {business.name} · Updated <time datetime={g.published}>{fmt}</time></p>
      </div>
    </header>
    <div class="section--tight section--line">
      <div class="wrap split split--aside">
        <div class="prose" set:html={g.html} />
        <aside class="sticky-side">
          <h2 style="font-size:var(--t-h3);letter-spacing:-0.005em;font-weight:650;line-height:1.2">Need to speak to someone?</h2>
          <p style="margin-top:var(--s-3)">Coordinators answer around the clock on <a class="link" href={telHref}>{business.phoneDisplay}</a>. You can also <a class="link" href="/book">send your trip details</a>.</p>
          <p class="small muted" style="margin-top:var(--s-4)">General information only, not medical advice. See our <a href="/disclaimer">disclaimer</a>.</p>
        </aside>
      </div>
    </div>
  </article>
  <section class="section--tight section--sand" aria-labelledby="more-h">
    <div class="wrap">
      <h2 id="more-h" style="font-size:clamp(1.75rem,1.4rem + 1.3vw,2.5rem);margin-bottom:var(--s-5)">More guides</h2>
      <div class="rows">
        {others.map((o) => <a class="row-link" style="grid-template-columns:1fr" href={`/blog/${o.slug}`}><h3>{o.title}</h3><p>{o.summary}</p></a>)}
      </div>
    </div>
  </section>
  <FinalCta />
</Base>
