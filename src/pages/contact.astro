---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import ContactActions from '../components/ContactActions.astro';
import ContactForm from '../components/ContactForm.astro';
import CallbackForm from '../components/CallbackForm.astro';
import { business, telHref, waHref, fullAddress } from '../data/business';

const site = (Astro.site?.href ?? '').replace(/\/$/, '');
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Contact', href: '/contact' }];
---
<Base title="Contact Best Ambulance Service | Phone, WhatsApp & LB Nagar Address" description="Call or WhatsApp +91 88210 84108, 24×7. Send a message or request a callback for planned transfers. Office at Chintalkunta Check Post, LB Nagar, Hyderabad." crumbs={crumbs} pageType="ContactPage">
  <Crumbs items={crumbs} />
  <section class="page-hero">
    <div class="wrap">
      <h1 class="h1-page">For an emergency, call first.</h1>
      <p class="lead">Phone and WhatsApp are monitored around the clock. Use the forms below for planned requests and general questions.</p>
      <ContactActions plan />
    </div>
  </section>

  <section class="section section--line" aria-labelledby="d-h">
    <div class="wrap split">
      <div>
        <h2 id="d-h" style="font-size:clamp(1.75rem,1.4rem + 1.3vw,2.5rem)">Contact details</h2>
        <dl class="nap">
          <dt>Emergency line</dt>
          <dd><a href={telHref}>{business.phoneDisplay}</a></dd>
          <dt>WhatsApp</dt>
          <dd><a href={waHref('Hello, I would like to ask about an ambulance.')} rel="noopener">{business.phoneDisplay}</a></dd>
          <dt>Email (not for emergencies)</dt>
          <dd><a href={`mailto:${business.email}`}>{business.email}</a></dd>
          <dt>Availability</dt>
          <dd>{business.hours}</dd>
          <dt>Address</dt>
          <dd><address class="nap">{fullAddress}</address></dd>
          <dd><a class="link" href={business.mapsUrl} rel="noopener">Open in Google Maps and get directions</a></dd>
          <dt>Coverage</dt>
          <dd>Hyderabad, Secunderabad and surrounding areas. <a class="link" href="/services/outstation-ambulance">Outstation transfers</a> from Hyderabad.</dd>
          <dt>Registration</dt>
          <dd>GSTIN {business.gstin}<br />PAN {business.pan}</dd>
        </dl>
      </div>
      <div>
        <h2 id="m-h" style="font-size:clamp(1.75rem,1.4rem + 1.3vw,2.5rem);margin-bottom:var(--s-5)">Send a message</h2>
        <ContactForm />
      </div>
    </div>
  </section>

  <section class="section section--sand" id="callback" aria-labelledby="c-h">
    <div class="wrap split">
      <div>
        <h2 id="c-h">Prefer us to call you?</h2>
        <p class="lead" style="margin-top:var(--s-4)">Leave your name and number and a coordinator will call you back. For anything urgent, please call us instead.</p>
      </div>
      <CallbackForm />
    </div>
  </section>
</Base>
